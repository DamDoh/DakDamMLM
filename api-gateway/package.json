{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "NODE_ENV=production next build",
    "start": "next start --port 3000",
    "start:test": "NODE_ENV=test next start --port 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "jest --testPathPattern=smoke",
    "test:post-deployment": "jest --testPathPattern=post-deployment",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "NODE_ENV=test prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "NODE_ENV=test tsx prisma/seed.ts",
    "db:seed:performance": "NODE_ENV=test PERFORMANCE_SEED=true tsx prisma/seed.ts",
    "db:seed:e2e": "NODE_ENV=test E2E_SEED=true tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "prepare": "husky install",
    "commit": "cz",
    "release": "semantic-release",
    "docker:build": "docker build -t dakdam-mlm .",
    "docker:run": "docker run -p 3000:3000 dakdam-mlm",
    "security:audit": "npm audit --audit-level high",
    "security:sast": "eslint src/ --ext .ts,.tsx --config .eslintrc.security.json",
    "seed": "tsx prisma/seed.ts"
  },
