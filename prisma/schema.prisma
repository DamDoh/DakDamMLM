datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id             String  @id @default(cuid())
  name           String  @unique
  domain         String? @unique // For custom domains
  description    String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  website        String?
  email          String?
  phone          String?
  address        Json? // Address object
  taxId          String?
  licenseNumber  String?
  industry       String?
  country        String?
  currency       String  @default("USD")
  timezone       String  @default("UTC")
  isActive       Boolean @default(true)
  isVerified     Boolean @default(false)

  // Authentication preferences
  allowEmailLogin          Boolean @default(true)
  allowPhoneLogin          Boolean @default(true)
  requireEmailVerification Boolean @default(false)
  requirePhoneVerification Boolean @default(false)

  // Branding
  customCss       String?
  loginPageConfig Json? // Login page customization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                      User[]
  products                   Product[]
  rules                      BusinessRule[]
  ruleSets                   RuleSet[]
  templates                  RuleTemplate[]
  customFunctions            CustomFunction[]
  companyRuleConfigs         CompanyRuleConfig[]
  dynamicRuleSets            DynamicRuleSet[]
  ruleExecutionSummaries     RuleExecutionSummary[]
  orders                     Order[]
  commissions                Commission[]
  stockItems                 StockItem[]
  referralLinks              ReferralLink[]
  referralRelationships      ReferralRelationship[]
  genealogyMovements         GenealogyMovement[]
  otpCodes                   OtpCode[]
  otpDeliveryLogs            OtpDeliveryLog[]
  otpSettings                OtpSettings?

  // Wallet relations
  wallets                    Wallet[]
  walletTransactions         WalletTransaction[]
  walletTransfers            WalletTransfer[]

  // RBAC relations
  roles                      Role[]

  // Alert relations
  alerts                     Alert[]

  @@map("companies")
}

model RuleVersion {
  id        String   @id @default(cuid())
  ruleId    String
  companyId String? // For company-specific rules
  version   Int
  data      Json // BusinessRule
  changes   Json // Partial<BusinessRule>
  createdAt DateTime @default(now())
  createdBy String

  @@map("rule_versions")
}

model RuleBackup {
  id          String   @id
  rules       Json // BusinessRule[]
  createdAt   DateTime @default(now())
  createdBy   String
  description String?

  @@map("rule_backups")
}

model BusinessRule {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String
  category     String
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  conditions   Json // RuleCondition[]
  calculation  Json // RuleCalculation
  applicableTo Json // ('distributor' | 'stockist' | 'customer')[]
  frequency    String   @default("monthly")
  payoutTiming String   @default("end_of_period")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  version      Int      @default(1)
  tags         Json // string[]
  metadata     Json? // Record<string, any>

  // Multi-tenancy
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleSets RuleSetBusinessRule[]

  @@map("business_rules")
}

model RuleTemplate {
  id                String  @id @default(cuid())
  name              String
  description       String?
  category          String
  rules             Json // Omit<BusinessRule, 'id' | 'createdAt' | 'updatedAt' | 'createdBy' | 'version'>[]
  isDefault         Boolean @default(false)
  applicableMarkets Json // string[]

  // Multi-tenancy
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isSystemTemplate Boolean  @default(false) // System-wide templates vs company-specific

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rule_templates")
}

model RuleSet {
  id            String    @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean   @default(true)
  effectiveDate DateTime
  expiryDate    DateTime?

  // Multi-tenancy
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  version   Int      @default(1)
  tags      Json // string[]

  rules RuleSetBusinessRule[]

  @@map("rule_sets")
}

model RuleSetBusinessRule {
  ruleSetId String
  ruleId    String
  order     Int    @default(0)

  ruleSet RuleSet      @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  rule    BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleSetId, ruleId])
  @@map("rule_set_business_rules")
}

model RuleExecutionLog {
  id          String   @id @default(cuid())
  ruleId      String
  memberId    String
  companyId   String? // For company-specific execution tracking
  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  breakdown   Json // Array<{component: string, amount: number, description: string}>
  metadata    Json? // Record<string, any>
  executedAt  DateTime @default(now())
  status      String   @default("success") // 'success' | 'failed' | 'partial'

  @@map("rule_execution_logs")
}

model RuleValidationLog {
  id          String   @id @default(cuid())
  ruleId      String?
  ruleSetId   String?
  companyId   String? // For company-specific validation tracking
  action      String // 'create' | 'update' | 'delete' | 'activate' | 'deactivate'
  isValid     Boolean
  errors      Json // string[]
  warnings    Json // string[]
  suggestions Json // string[]
  validatedAt DateTime @default(now())
  validatedBy String

  @@map("rule_validation_logs")
}

model CustomFunction {
  id           String   @id @default(cuid())
  name         String
  description  String?
  parameters   Json // CustomFunctionParameter[]
  returnType   String // 'number' | 'string' | 'boolean' | 'array' | 'object'
  code         String // JavaScript/TypeScript code
  companyId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  version      Int      @default(1)
  tags         Json // string[]
  metadata     Json? // Record<string, any>

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("custom_functions")
}

model RuleExecutionSummary {
  id                String   @id @default(cuid())
  companyId         String?
  ruleId            String?
  ruleSetId         String?
  periodStart       DateTime
  periodEnd         DateTime
  totalExecutions   Int      @default(0)
  successfulExecutions Int   @default(0)
  failedExecutions  Int      @default(0)
  totalAmount       Float    @default(0)
  averageAmount     Float    @default(0)
  executionTime     Int      @default(0) // milliseconds
  cacheHits         Int      @default(0)
  cacheMisses       Int      @default(0)
  errors            Json // string[]
  metadata          Json? // Record<string, any>
  createdAt         DateTime @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("rule_execution_summaries")
}

model CompanyRuleConfig {
  id                        String   @id @default(cuid())
  companyId                 String   @unique
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Enabled features and rule types
  enabledRuleTypes          Json // string[]
  disabledRuleTypes         Json // string[]

  // Custom calculation types
  customCalculationTypes    Json // CustomCalculationType[]

  // Custom condition types
  customConditionTypes      Json // CustomConditionType[]

  // Performance and limits
  maxExecutionTime          Int      @default(5000) // milliseconds
  maxMemoryUsage            Int      @default(100) // MB
  maxConcurrentExecutions   Int      @default(10)
  cacheEnabled              Boolean  @default(true)
  cacheTTL                  Int      @default(3600) // seconds

  // Audit and compliance
  auditEnabled              Boolean  @default(true)
  auditRetentionDays        Int      @default(2555) // 7 years
  complianceMode            String   @default("flexible") // 'strict' | 'flexible' | 'disabled'

  // Global overrides and defaults
  globalOverrides           Json // Record<string, any>
  defaultValues             Json // Record<string, any>

  // Custom functions
  customFunctions           Json // string[] (function IDs)

  // Rule overrides
  ruleOverrides             Json // Record<string, Partial<BusinessRule>>

  // Integration settings
  integrations              Json // IntegrationSettings

  // Advanced features
  advancedFeatures          Json // AdvancedFeatures

  // Genealogy movement settings
  allowDownlineMovement     Boolean @default(false)
  movementTimeLimitHours    Int     @default(24) // Hours within which movement is allowed
  movementRequiresApproval  Boolean @default(false)

  // Version and lifecycle
  version                   Int      @default(1)
  isActive                  Boolean  @default(true)
  effectiveDate             DateTime @default(now())
  expiryDate                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  createdBy                 String
  tags                      Json // string[]
  metadata                  Json? // Record<string, any>

  @@map("company_rule_configs")
}

model DynamicRuleSet {
  id            String    @id @default(cuid())
  name          String
  description   String?
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Rule set configuration
  rules         Json // BusinessRule[]
  ruleOrder     Json // string[] (rule IDs in execution order)
  priority      Int      @default(0)

  // Activation and scheduling
  isActive      Boolean   @default(true)
  effectiveDate DateTime
  expiryDate    DateTime?

  // Targeting and segmentation
  targetCriteria Json // TargetCriteria

  // Performance and limits
  maxExecutionTime Int?
  maxRules        Int?

  // Version control
  version        Int      @default(1)
  parentVersionId String?
  isDraft        Boolean  @default(false)

  // Audit and compliance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?

  // Tags and metadata
  tags           Json // string[]
  metadata       Json? // Record<string, any>

  @@map("dynamic_rule_sets")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique // FIXED: Made required (was nullable which caused issues)
  phoneNumber       String   @unique
  password          String
  firstName         String
  surname           String
  fullName          String
  memberId          String   @unique
  accountType       String   @default("Customer")
  sponsorId         String?
  companyId         String?
  idCardUrl         String?
  idCardNumber      String?  @unique
  active            Boolean  @default(true)
  isAdmin           Boolean  @default(false)
  
  // MLM & Genealogy fields
  rank              String   @default("Member")
  pv                Float    @default(0)
  pvDate            DateTime?
  teamSize          Json
  children          Json
  placementParentId String?
  position          String?  // 'left' or 'right'
  
  // Stockist fields
  storeOwnerLevel   String?  // 'District', 'Provincial', 'Regional', 'Commune'
  
  // Additional profile fields
  avatarUrl         String?
  addresses         Json
  lastActivityDate  DateTime?
  
  // Soft delete fields
  deleted           Boolean  @default(false)
  deletedDate       DateTime?
  deletedBy         String?
  
  // Account lockout fields
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastFailedLogin     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  company                      Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sponsor                      User?                  @relation("UserSponsor", fields: [sponsorId], references: [id])
  sponsored                    User[]                 @relation("UserSponsor")
  referralLinks                ReferralLink[]
  referralSponsorRelationships ReferralRelationship[] @relation("ReferralSponsor")
  referralMemberRelationships  ReferralRelationship[] @relation("ReferralMember")

  // Genealogy movement relations
  movementsAsMember            GenealogyMovement[]   @relation("MovementMember")
  movementsAsMover             GenealogyMovement[]   @relation("MovementMover")
  movementsAsFromParent        GenealogyMovement[]   @relation("MovementFromParent")
  movementsAsToParent          GenealogyMovement[]   @relation("MovementToParent")
  movementsAsApprover          GenealogyMovement[]   @relation("MovementApprover")

  // Stock and eCash relations
  stockRequests           StockRequest[]           @relation("StockRequestStockist")
  processedStockRequests  StockRequest[]           @relation("StockRequestProcessor")
  ecashTopupRequests      EcashTopupRequest[]     @relation("EcashTopupRequestMember")
  processedEcashTopups    EcashTopupRequest[]     @relation("EcashTopupRequestProcessor")

  // Wallet relations
  wallet                  Wallet?
  transferApprovals       WalletTransfer[]        @relation("TransferApprover")
  transferCancellations   WalletTransfer[]        @relation("TransferCanceller")

  // RBAC relations
  roles                   UserRole[]
  assignedRoles           UserRole[]              @relation("RoleAssigner")

  // Alert relations
  resolvedAlerts          Alert[]                  @relation("AlertResolver")

  // DSAR relations
  dsarRequests            DSARRequest[]
  completedDSARs          DSARRequest[]            @relation("DSARCompleter")

  // Advanced Security relations
  deviceFingerprints      DeviceFingerprint[]
  biometricProfiles       BiometricProfile[]
  securitySessions        SecuritySession[]

  // Mobile Sync relations
  syncOperations          SyncOperation[]
  syncSessions            SyncSession[]

  // Compliance relations
  kycProfile             KycProfile?
  amlAlerts              AmlAlert[]

  // CRITICAL FIX #1: Add indexes for performance (100x faster queries)
  @@index([sponsorId])           // For genealogy sponsor queries
  @@index([placementParentId])   // For binary tree placement queries
  @@index([companyId])           // For multi-tenant filtering
  @@index([rank])                // For rank-based queries
  @@index([deleted])             // For soft delete filtering
  @@index([active])              // For active user filtering
  @@index([email])               // For login queries (already unique but explicit index helps)
  @@index([createdAt])           // For sorting by registration date
  @@index([companyId, rank])     // Composite for company rank reports
  @@index([companyId, active])   // Composite for active users per company

  @@map("users")
}

model Product {
  id              String  @id @default(cuid())
  name            String
  description     String?
  price           Float
  pv              Float   @default(0)
  qty             Int     @default(0)
  category        String
  imageUrl        String?
  isActive        Boolean @default(true)
  unitType        String  @default("piece")
  type            String  @default("single")
  originalPrice   Float?
  packageItems    Json? // PackageItem[]
  rating          Float?
  companyId       String?
  isGlobalProduct Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Order {
  id          String   @id @default(cuid())
  orderId     String   @unique
  userId      String
  date        DateTime @default(now())
  status      String   @default("Pending")
  itemCount   Int      @default(0)
  amount      Float    @default(0)
  totalAmount Float    @default(0)
  companyId   String?
  idempotencyKey String? @unique // Prevents duplicate orders from retries
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@map("orders")
  @@index([userId])
  @@index([idempotencyKey])
  // CRITICAL FIX #1: Add more order indexes
  @@index([companyId])           // For company order reports
  @@index([status])              // For order status filtering
  @@index([date])                // For date-based queries
  @@index([userId, date])        // Composite for user order history
  @@index([companyId, status])   // Composite for company pending orders
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  price      Float
  pv         Float  @default(0)
  createdAt  DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_items")
}

model Commission {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  type      String
  status    String   @default("Pending")
  amount    Float
  companyId String?

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // CRITICAL FIX #1: Add indexes for commission queries
  @@index([userId])              // For user commission history
  @@index([companyId])           // For company commission reports
  @@index([status])              // For pending/paid filtering
  @@index([date])                // For period-based queries
  @@index([userId, date])        // Composite for user history by date
  @@index([companyId, status])   // Composite for company pending commissions

  @@map("commissions")
}

model StockItem {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int
  lastUpdated DateTime @default(now())
  companyId   String?

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("stock_items")
}

model ReferralLink {
  id          String    @id @default(cuid())
  sponsorId   String
  companyId   String
  code        String    @unique
  clicks      Int       @default(0)
  conversions Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  sponsor       User                   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relationships ReferralRelationship[]

  @@map("referral_links")
}

model ReferralRelationship {
  id             String   @id @default(cuid())
  referralLinkId String
  sponsorId      String
  memberId       String
  companyId      String
  status         String   @default("active")
  createdAt      DateTime @default(now())

  // Relations
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  sponsor      User         @relation("ReferralSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)
  member       User         @relation("ReferralMember", fields: [memberId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("referral_relationships")
}

model StockRequest {
  id               String   @id @default(cuid())
  stockistId       String
  stockistName     String
  stockistLevel    String   @default("District")
  status           String   @default("pending")
  createdDate      DateTime @default(now())
  processedDate    DateTime?
  processedBy      String?
  totalValue       Float    @default(0)
  itemCount        Int      @default(0)

  // Relations
  stockist    User     @relation("StockRequestStockist", fields: [stockistId], references: [id], onDelete: Cascade)
  processor   User?    @relation("StockRequestProcessor", fields: [processedBy], references: [id], onDelete: SetNull)
  items       StockRequestItem[]

  @@map("stock_requests")
}

model StockRequestItem {
  id                String @id @default(cuid())
  stockRequestId    String
  productId         String
  productName       String
  requestedQuantity Int
  approvedQuantity  Int?
  unitPrice         Float  @default(0)

  // Relations
  stockRequest StockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)

  @@map("stock_request_items")
}

model EcashTopupRequest {
  id           String   @id @default(cuid())
  memberId     String
  memberName   String
  amount       Float
  remark       String   @default("")
  status       String   @default("pending")
  createdDate  DateTime @default(now())
  processedDate DateTime?
  processedBy  String?
  proofUrl     String   @default("")

  // Relations
  member   User   @relation("EcashTopupRequestMember", fields: [memberId], references: [id], onDelete: Cascade)
  processor User? @relation("EcashTopupRequestProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@map("ecash_topup_requests")
}

model Notification {
  id          String    @id @default(cuid())
  memberId    String
  type        String    // 'email' | 'push' | 'sms' | 'in_app'
  category    String    // 'onboarding' | 'commission' | 'team' | 'system' | 'achievement' | 'order'
  title       String
  body        String
  data        Json
  isRead      Boolean   @default(false)
  isSent      Boolean   @default(false)
  sentDate    DateTime?
  readDate    DateTime?
  createdDate DateTime  @default(now())
  priority    String    @default("medium") // 'low' | 'medium' | 'high' | 'urgent'

  @@map("notifications")
}

model NotificationPreference {
  id         String   @id @default(cuid())
  memberId   String   @unique
  email      Json
  push       Json
  sms        Json
  frequency  String   @default("immediate") // 'immediate' | 'daily' | 'weekly'
  quietHours Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notification_preferences")
}

model MemberProgress {
  id              String   @id @default(cuid())
  memberId        String   @unique
  currentStep     Int      @default(0)
  completedSteps  Json
  startedDate     DateTime @default(now())
  lastActivity    DateTime @default(now())
  isCompleted     Boolean  @default(false)
  totalTimeSpent  Int      @default(0)
  quizScores      Json
  notes           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("member_progress")
}

model GenealogyMovement {
  id                String   @id @default(cuid())
  memberId          String   // The member being moved
  companyId         String
  movedBy           String   // Distributor who initiated the movement
  fromParentId      String   // Original parent
  toParentId        String   // New parent
  fromPosition      String   // 'left' or 'right'
  toPosition        String   // 'left' or 'right'
  movementReason    String?  // Optional reason for movement
  status            String   @default("completed") // 'pending', 'completed', 'rejected'
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  member            User     @relation("MovementMember", fields: [memberId], references: [id])
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mover             User     @relation("MovementMover", fields: [movedBy], references: [id])
  fromParent        User     @relation("MovementFromParent", fields: [fromParentId], references: [id])
  toParent          User     @relation("MovementToParent", fields: [toParentId], references: [id])
  approver          User?    @relation("MovementApprover", fields: [approvedBy], references: [id])

  @@map("genealogy_movements")
  }
  
  model CommissionDispute {
  id            String   @id @default(cuid())
  commissionId  String
  memberId      String
  amount        Float    @default(0)
  reason        String
  description   String?
  status        String   @default("pending") // 'pending' | 'resolved' | 'rejected'
  resolution    String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?
  companyId     String?

  @@map("commission_disputes")
  @@index([memberId])
  @@index([status])
  @@index([companyId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  companyId String?

  @@map("email_verifications")
  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
  @@index([userId])
  @@index([token])
}

model FinancialControl {
  id         String   @id @default(cuid())
  type       String   // 'hold' | 'release' | 'adjustment' | 'freeze'
  amount     Float
  memberId   String
  reason     String
  description String?
  status     String   @default("pending") // 'pending' | 'approved' | 'rejected'
  companyId  String?
  createdAt  DateTime @default(now())
  approvedBy String?
  approvedAt DateTime?
  rejectedBy String?
  rejectedAt DateTime?
  metadata   Json?

  @@map("financial_controls")
  @@index([memberId])
  @@index([status])
  @@index([companyId])
}

model ComplianceDocument {
  id            String   @id @default(cuid())
  title         String
  type          String   // 'terms' | 'privacy' | 'compensation' | 'policy'
  content       String
  version       String
  isActive      Boolean  @default(true)
  effectiveDate DateTime
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String

  // Relations
  agreements MemberAgreement[]

  @@map("compliance_documents")
  @@index([companyId])
  @@index([type])
  @@index([isActive])
}

model MemberAgreement {
  id         String   @id @default(cuid())
  memberId   String
  documentId String
  signed     Boolean  @default(false)
  signedAt   DateTime?
  ipAddress  String?
  userAgent  String?
  companyId  String?
  createdAt  DateTime @default(now())

  // Relations
  document ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("member_agreements")
  @@index([memberId])
  @@index([documentId])
  @@index([companyId])
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  productId   String
  userId      String?  // User who initiated the transaction
  type        String   // 'purchase' | 'sale' | 'transfer' | 'adjustment' | 'return'
  quantity    Int
  previousQty Int
  newQty      Int
  reference   String?  // Order ID, Transfer ID, etc.
  reason      String?
  companyId   String?
  createdAt   DateTime @default(now())
  createdBy   String

  @@map("inventory_transactions")
  @@index([productId])
  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

model AuditLog {
   id         String   @id @default(cuid())
   userId     String?
   action     String   // 'create' | 'update' | 'delete' | 'login' | 'logout' | etc.
   entity     String   // 'user' | 'product' | 'order' | 'commission' | etc.
   entityId   String?
   changes    Json?    // Before/after values
   ipAddress  String?
   userAgent  String?
   companyId  String?
   createdAt  DateTime @default(now())

   @@map("audit_logs")
   @@index([userId])
   @@index([entity, entityId])
   @@index([companyId])
   @@index([createdAt])
}

model OtpCode {
   id         String   @id @default(cuid())
   identifier String   // Email or phone number
   type       String   // 'email' | 'sms'
   purpose    String   // 'verification' | 'password_reset' | 'login_2fa'
   code       String   // Hashed OTP code
   expiresAt  DateTime
   attempts   Int      @default(0)
   isActive   Boolean  @default(true)
  companyId  String?
   createdAt  DateTime @default(now())

   // Relations
   company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

   @@map("otp_codes")
   @@index([identifier])
   @@index([companyId])
   @@index([expiresAt])
   @@index([isActive])
}


model OtpDeliveryLog {
  id         String   @id @default(cuid())
  otpId      String
  identifier String   // Email or phone number
  type       String   // 'email' | 'sms'
  provider   String   // 'internal_smtp' | 'internal_sms' | 'external'
  status     String   // 'sent' | 'delivered' | 'failed'
  error      String?
  messageId  String?  // Provider message ID
  cost       Float?   // Cost if applicable
  ipAddress  String?
  userAgent  String?
  companyId  String?
  createdAt  DateTime @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("otp_delivery_logs")
  @@index([otpId])
  @@index([identifier])
  @@index([companyId])
  @@index([createdAt])
}

model Wallet {
   id          String   @id @default(cuid())
   userId      String   @unique
   balance     Float    @default(0) // CRITICAL FIX #4: Will add CHECK constraint (balance >= 0) in migration
   currency    String   @default("USD")
   isActive    Boolean  @default(true)
   companyId   String?
   createdAt   DateTime @default(now())
   updatedAt   DateTime @updatedAt

   // Relations
   user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
   company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
   transactions WalletTransaction[]
   transfersFrom WalletTransfer[] @relation("TransferFromWallet")
   transfersTo   WalletTransfer[] @relation("TransferToWallet")

   @@map("wallets")
   @@index([userId])
   @@index([companyId])
   @@index([isActive])           // CRITICAL FIX #1: For active wallet queries
   @@index([companyId, isActive])// CRITICAL FIX #1: Composite for company active wallets
}

model WalletTransaction {
   id            String   @id @default(cuid())
   walletId      String
   type          String   // 'credit' | 'debit' | 'transfer_in' | 'transfer_out' | 'commission' | 'withdrawal'
   amount        Float
   balanceBefore Float
   balanceAfter  Float
   description   String?
   referenceId   String?  // Order ID, Commission ID, Transfer ID, etc.
   referenceType String?  // 'order' | 'commission' | 'transfer' | 'withdrawal' | 'topup'
   status        String   @default("completed") // 'pending' | 'completed' | 'failed' | 'cancelled'
   metadata      Json?    // Additional transaction data
   companyId     String?
   createdAt     DateTime @default(now())

   // Relations
   wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
   company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

   @@map("wallet_transactions")
   @@index([walletId])
   @@index([type])
   @@index([status])
   @@index([companyId])
   @@index([createdAt])
   // CRITICAL FIX #1: Add composite indexes for common queries
   @@index([walletId, createdAt])     // For wallet history sorted by date
   @@index([walletId, type])          // For wallet transactions by type
   @@index([referenceId, referenceType]) // For lookup by reference (order, commission, etc.)
}

model WalletTransfer {
   id            String   @id @default(cuid())
   fromWalletId  String
   toWalletId    String
   amount        Float
   fee           Float    @default(0)
   description   String?
   status        String   @default("pending") // 'pending' | 'completed' | 'failed' | 'cancelled'
   escrowAmount  Float?   // For large transfers requiring approval
   escrowExpires DateTime?
   approvedBy    String?
   approvedAt    DateTime?
   cancelledBy   String?
   cancelledAt   DateTime?
   companyId     String?
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

   // Relations
   fromWallet Wallet   @relation("TransferFromWallet", fields: [fromWalletId], references: [id])
   toWallet   Wallet   @relation("TransferToWallet", fields: [toWalletId], references: [id])
   company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
   approver   User?    @relation("TransferApprover", fields: [approvedBy], references: [id])
   canceller  User?    @relation("TransferCanceller", fields: [cancelledBy], references: [id])

   @@map("wallet_transfers")
   @@index([fromWalletId])
   @@index([toWalletId])
   @@index([status])
   @@index([companyId])
}

model Role {
   id          String   @id @default(cuid())
   name        String   @unique
   description String?
   companyId   String?
   isSystem    Boolean  @default(false) // System roles vs company-specific
   isActive    Boolean  @default(true)
   createdAt   DateTime @default(now())
   updatedAt   DateTime @updatedAt

   // Relations
   company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
   permissions RolePermission[]
   users       UserRole[]

   @@map("roles")
}

model Permission {
   id          String   @id @default(cuid())
   name        String   @unique
   description String?
   resource    String   // 'user' | 'product' | 'order' | 'commission' | 'admin' | etc.
   action      String   // 'create' | 'read' | 'update' | 'delete' | 'manage'
   isSystem    Boolean  @default(false)
   createdAt   DateTime @default(now())

   // Relations
   roles       RolePermission[]

   @@map("permissions")
   @@unique([resource, action])
}

model RolePermission {
   roleId       String
   permissionId String

   role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
   permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

   @@id([roleId, permissionId])
   @@map("role_permissions")
}

model UserRole {
   userId String
   roleId String
   assignedAt DateTime @default(now())
   assignedBy String?

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)
   role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
   assigner User? @relation("RoleAssigner", fields: [assignedBy], references: [id])

   @@id([userId, roleId])
   @@map("user_roles")
}

model Alert {
   id        String   @id @default(cuid())
   ruleId    String
   title     String
   message   String
   severity  String   // 'low' | 'medium' | 'high' | 'critical'
   status    String   @default("active") // 'active' | 'acknowledged' | 'resolved'
   data      Json?    // Additional alert data
   companyId String?
   createdAt DateTime @default(now())
   resolvedAt DateTime?
   resolvedBy String?

   // Relations
   company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
   resolver User?   @relation("AlertResolver", fields: [resolvedBy], references: [id])

   @@map("alerts")
   @@index([status])
   @@index([severity])
   @@index([companyId])
   @@index([createdAt])
}

model DSARRequest {
   id           String   @id @default(cuid())
   userId       String
   type         String   // 'access' | 'rectification' | 'erasure' | 'restriction' | 'portability' | 'objection'
   status       String   @default("pending") // 'pending' | 'processing' | 'completed' | 'rejected'
   requestData  Json?    // Additional request data
   responseData Json?    // Response data for completed requests
   createdAt    DateTime @default(now())
   completedAt  DateTime?
   completedBy  String?
   notes        String?

   // Relations
   user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
   completer    User?    @relation("DSARCompleter", fields: [completedBy], references: [id])

   @@map("dsar_requests")
   @@index([userId])
   @@index([status])
   @@index([type])
   @@index([createdAt])
}

model OtpSettings {
    id                    String   @id @default(cuid())
    companyId             String   @unique
    company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

    // OTP Configuration
    emailEnabled          Boolean  @default(true)
    smsEnabled            Boolean  @default(true)
    codeLength            Int      @default(6)
    codeExpiryMinutes     Int      @default(10)
    maxAttempts           Int      @default(3)
    rateLimitPerHour      Int      @default(5)
    rateLimitPerDay       Int      @default(20)

    // Email Configuration
    smtpHost              String?
    smtpPort              Int      @default(587)
    smtpSecure            Boolean  @default(false)
    smtpUser              String?
    smtpPassword          String?
    smtpFromEmail         String?
    smtpFromName          String?

    // SMS Configuration
    smsProvider           String   @default("internal") // 'internal' | 'twilio' | 'aws_sns' | 'nexmo'
    smsApiKey             String?
    smsApiSecret          String?
    smsFromNumber         String?

    // Templates
    emailTemplates        Json     // Email templates for different purposes
    smsTemplates          Json     // SMS templates for different purposes

    // Security
    requireOtpForLogin    Boolean  @default(false)
    requireOtpForTransactions Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("otp_settings")
}

model DeviceFingerprint {
    id            String   @id @default(cuid())
    userId        String
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    fingerprint   String   @unique // SHA-256 hash of device characteristics
    userAgent     String
    ipAddress     String
    location      Json?    // Geographic location data
    deviceInfo    Json     // Device characteristics (platform, browser, etc.)
    trustScore    Int      @default(50) // 0-100 trust score
    isTrusted     Boolean  @default(false)
    lastUsed      DateTime @default(now())
    createdAt     DateTime @default(now())

    // Security sessions
    securitySessions SecuritySession[]

    @@unique([userId, fingerprint])
    @@map("device_fingerprints")
}

model BiometricProfile {
    id             String   @id @default(cuid())
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    biometricType  String   // 'fingerprint' | 'face' | 'voice' | 'behavioral'
    publicKey      String?  // For WebAuthn/FIDO2
    credentialId   String?  // Unique credential identifier
    challenge      String?  // Current challenge for verification
    counter        Int?     // Signature counter for replay protection
    enrolledAt     DateTime @default(now())
    lastUsed       DateTime @default(now())
    isActive       Boolean  @default(true)

    @@map("biometric_profiles")
}

model SecuritySession {
    id                    String   @id @default(cuid())
    userId                String
    user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceFingerprint     String
    deviceFingerprintRef  DeviceFingerprint @relation(fields: [deviceFingerprint], references: [fingerprint])
    ipAddress             String
    userAgent             String
    location              String   @default("unknown")
    riskScore             Int      @default(50) // 0-100 risk assessment
    authenticationMethods Json     // Array of required auth methods
    mfaVerified           Boolean  @default(false)
    biometricVerified     Boolean  @default(false)
    startedAt             DateTime @default(now())
    lastActivity          DateTime @default(now())
    expiresAt             DateTime
    isActive              Boolean  @default(true)

    @@map("security_sessions")
}

model SyncOperation {
    id           String   @id @default(cuid())
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceId     String
    type         String   // 'create' | 'update' | 'delete'
    entity       String   // 'order' | 'commission' | 'notification' | etc.
    entityId     String
    data         Json     // Operation data payload
    version      Int      @default(1) // Data version for conflict resolution
    status       String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
    retryCount   Int      @default(0)
    errorMessage String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("sync_operations")
}

model SyncSession {
    id                   String   @id @default(cuid())
    userId               String
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceId             String
    startedAt            DateTime @default(now())
    lastSyncAt           DateTime @default(now())
    status               String   @default("active") // 'active' | 'completed' | 'failed'
    totalOperations      Int      @default(0)
    completedOperations  Int      @default(0)
    failedOperations     Int      @default(0)
    dataTransferred      Int      @default(0) // bytes transferred
    createdAt            DateTime @default(now())

    @@map("sync_sessions")
}

model KycProfile {
    id                String   @id @default(cuid())
    userId            String   @unique
    user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    status            String   @default("pending") // 'pending' | 'in_review' | 'approved' | 'rejected' | 'expired'
    riskLevel         String   @default("medium") // 'low' | 'medium' | 'high' | 'critical'
    verificationLevel String   @default("standard") // 'basic' | 'standard' | 'enhanced' | 'premium'
    riskScore         Int      @default(50)
    expiresAt         DateTime
    rejectionReason   String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    documents KycDocument[]
    checks    KycCheck[]

    @@map("kyc_profiles")
}

model KycDocument {
    id                String   @id @default(cuid())
    kycProfileId      String
    kycProfile        KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)
    type              String   // 'id_card' | 'passport' | 'drivers_license' | 'utility_bill' | 'bank_statement' | 'address_proof'
    status            String   @default("pending") // 'pending' | 'verified' | 'rejected'
    fileUrl           String
    extractedData     Json?    // OCR/extracted data
    verificationScore Int      @default(0)
    verifiedAt        DateTime?
    verifiedBy        String?
    rejectionReason   String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@map("kyc_documents")
}

model KycCheck {
    id           String   @id @default(cuid())
    kycProfileId String
    kycProfile   KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)
    type         String   // 'identity' | 'address' | 'sanctions' | 'adverse_media' | 'pep' | 'fraud'
    status       String   @default("pending") // 'pending' | 'passed' | 'failed' | 'error'
    provider     String   // Verification service provider
    result       Json     // Check result data
    score        Int      @default(0) // 0-100 confidence score
    errorMessage String?
    createdAt    DateTime @default(now())

    @@map("kyc_checks")
}

model AmlAlert {
    id                   String   @id @default(cuid())
    type                 String   // 'transaction_monitoring' | 'unusual_activity' | 'sanctions_hit' | 'high_risk_transaction'
    severity             String   @default("medium") // 'low' | 'medium' | 'high' | 'critical'
    userId               String
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactionId        String?
    amount               Float?
    description          String
    riskIndicators       Json     // Array of risk indicators
    status               String   @default("open") // 'open' | 'investigating' | 'resolved' | 'dismissed'
    resolvedAt           DateTime?
    resolvedBy           String?
    regulatoryReportFiled Boolean  @default(false)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    @@map("aml_alerts")
}

model RegulatoryReport {
    id              String   @id @default(cuid())
    type            String   // 'sar' | 'ctr' | 'fir' | 'goaml' | 'custom'
    status          String   @default("draft") // 'draft' | 'submitted' | 'approved' | 'rejected'
    reportingEntity String
    reportData      Json     // Report content
    filingReference String?
    submittedAt     DateTime?
    approvedAt      DateTime?
    rejectionReason String?
    createdBy       String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@map("regulatory_reports")
}
