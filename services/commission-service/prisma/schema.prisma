// Prisma schema for Commission Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Commission {
  id            String            @id @default(cuid())
  userId        String
  orderId       String?
  type          CommissionType
  level         Int               @default(1)
  amount        Float
  percentage    Float
  status        CommissionStatus  @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?            @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("commissions")
}

model CommissionRule {
  id            String            @id @default(cuid())
  name          String
  type          CommissionType
  level         Int
  percentage    Float
  minAmount     Float             @default(0)
  maxAmount     Float?
  isActive      Boolean           @default(true)
  conditions    Json?             // Additional conditions for the rule
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type])
  @@index([level])
  @@index([isActive])
  @@map("commission_rules")
}

model CommissionCalculation {
  id            String   @id @default(cuid())
  orderId       String   @unique
  totalAmount   Float
  totalPV       Float
  calculations  Json     // Detailed calculation breakdown
  processedAt   DateTime @default(now())

  @@index([orderId])
  @@index([processedAt])
  @@map("commission_calculations")
}

model CommissionPayout {
  id            String            @id @default(cuid())
  userId        String
  amount        Float
  method        PayoutMethod
  status        PayoutStatus      @default(PENDING)
  reference     String?           // Bank transfer ref, PayPal ID, etc.
  processedAt   DateTime?
  paidAt        DateTime?
  fees          Float             @default(0)
  netAmount     Float
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@map("commission_payouts")
}

model CommissionBonus {
  id            String            @id @default(cuid())
  userId        String
  type          BonusType
  amount        Float
  description   String
  period        String            // Month/Quarter/Year
  achievedAt    DateTime
  paidAt        DateTime?
  createdAt     DateTime          @default(now())

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([period])
  @@index([achievedAt])
  @@map("commission_bonuses")
}

model CommissionLock {
  id            String            @id @default(cuid())
  userId        String
  orderId       String
  amount        Float
  reason        String
  lockedUntil   DateTime
  unlockedAt    DateTime?
  createdAt     DateTime          @default(now())

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order             @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([lockedUntil])
  @@map("commission_locks")
}

// User model (simplified for commission service)
model User {
  id          String   @id @default(cuid())
  memberId    String?  @unique
  fullName    String
  email       String?  @unique
  rank        String   @default("Member")
  sponsorId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  commissions     Commission[]
  payouts         CommissionPayout[]
  bonuses         CommissionBonus[]
  locks           CommissionLock[]

  @@index([memberId])
  @@index([sponsorId])
  @@index([active])
  @@map("users")
}

// Order model (simplified for commission service)
model Order {
  id            String   @id @default(cuid())
  userId        String
  totalAmount   Float
  totalPV       Float
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  // Relations
  commissions   Commission[]
  locks         CommissionLock[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// Enums
enum CommissionType {
  DIRECT         // Direct referral commission
  LEVEL_2        // Second level commission
  LEVEL_3        // Third level commission
  LEVEL_4        // Fourth level commission
  LEVEL_5        // Fifth level commission
  UNILEVEL       // Unilevel commission
  BINARY         // Binary commission
  MATRIX         // Matrix commission
  GENERATIONAL   // Generational commission
  PERFORMANCE    // Performance bonus
  LOYALTY        // Loyalty bonus
  LEADERSHIP     // Leadership bonus
  TRAVEL         // Travel bonus
  CAR            // Car bonus
  HOUSE          // House bonus
}

enum CommissionStatus {
  PENDING     // Commission calculated but not paid
  APPROVED    // Approved for payment
  PAID        // Commission paid to user
  CANCELLED   // Commission cancelled
  HELD        // Commission held (e.g., for qualification)
  LOCKED      // Commission locked due to disputes
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  CHECK
  WIRE_TRANSFER
  CRYPTO
  GIFT_CARD
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum BonusType {
  FAST_START      // Fast start bonus
  MONTHLY         // Monthly performance bonus
  QUARTERLY       // Quarterly bonus
  ANNUAL          // Annual bonus
  RANK_ADVANCEMENT // Rank advancement bonus
  RECRUITMENT    // Recruitment bonus
  TEAM_BUILDING  // Team building bonus
  BREAKAWAY      // Breakaway bonus
}