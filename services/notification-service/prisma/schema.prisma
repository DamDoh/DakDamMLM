// Prisma schema for Notification Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id            String            @id @default(cuid())
  userId        String
  type          NotificationType
  channel       NotificationChannel
  category      NotificationCategory
  priority      NotificationPriority @default(MEDIUM)
  title         String
  body          String
  data          Json?             // Additional data for the notification
  isRead        Boolean           @default(false)
  readAt        DateTime?
  isSent        Boolean           @default(false)
  sentAt        DateTime?
  sentVia       String?           // Email, SMS, Push provider used
  externalId    String?           // Provider's message ID
  failedAt      DateTime?
  failureReason String?
  scheduledAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([category])
  @@index([priority])
  @@index([isRead])
  @@index([isSent])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("notifications")
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  type        NotificationType
  channel     NotificationChannel
  category    NotificationCategory
  priority    NotificationPriority @default(MEDIUM)
  subject     String?  // For email notifications
  title       String
  body        String   // Template with {{variables}}
  dataSchema  Json?    // Schema for template variables
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  notifications Notification[]

  @@index([type])
  @@index([channel])
  @@index([category])
  @@index([isActive])
  @@map("notification_templates")
}

model UserNotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  smsEnabled            Boolean  @default(true)
  pushEnabled           Boolean  @default(true)
  marketingEmails       Boolean  @default(true)
  transactionalEmails   Boolean  @default(true)
  systemNotifications   Boolean  @default(true)
  commissionAlerts      Boolean  @default(true)
  orderUpdates          Boolean  @default(true)
  securityAlerts        Boolean  @default(true)
  quietHoursStart       String?  // HH:MM format
  quietHoursEnd         String?  // HH:MM format
  timezone              String   @default("UTC")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_notification_preferences")
}

model NotificationCampaign {
  id            String            @id @default(cuid())
  name          String
  description   String?
  type          CampaignType
  status        CampaignStatus    @default(DRAFT)
  targetUsers   Json              // Criteria for targeting users
  templateId    String
  scheduledAt   DateTime?
  sentAt        DateTime?
  completedAt   DateTime?
  totalRecipients Int             @default(0)
  sentCount     Int               @default(0)
  deliveredCount Int              @default(0)
  openedCount   Int               @default(0)
  clickedCount  Int               @default(0)
  failedCount   Int               @default(0)
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  template      NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([type])
  @@map("notification_campaigns")
}

model NotificationProvider {
  id            String            @id @default(cuid())
  name          String            @unique
  type          NotificationChannel
  provider      String            // sendgrid, twilio, firebase, etc.
  config        Json              // API keys, settings
  isActive      Boolean           @default(true)
  priority      Int               @default(1) // For failover
  rateLimit     Int?              // Messages per minute
  dailyLimit    Int?              // Messages per day
  monthlyLimit  Int?              // Messages per month
  costPerUnit   Float             @default(0) // Cost per message
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type])
  @@index([provider])
  @@index([isActive])
  @@index([priority])
  @@map("notification_providers")
}

model NotificationLog {
  id            String   @id @default(cuid())
  notificationId String
  providerId    String
  action        String   // sent, delivered, opened, clicked, failed
  status        String   // success, failed
  message       String?
  metadata      Json?    // Provider response, error details
  timestamp     DateTime @default(now())

  // Relations
  notification  Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  provider      NotificationProvider @relation(fields: [providerId], references: [id])

  @@index([notificationId])
  @@index([providerId])
  @@index([action])
  @@index([timestamp])
  @@map("notification_logs")
}

// User model (simplified for notification service)
model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  fullName    String
  memberId    String?  @unique
  rank        String   @default("Member")
  sponsorId   String?
  phoneNumber String?
  isAdmin     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  notifications Notification[]
  preferences   UserNotificationPreference?

  @@index([email])
  @@index([memberId])
  @@index([sponsorId])
  @@index([active])
  @@map("users")
}

// Enums
enum NotificationType {
  WELCOME
  PASSWORD_RESET
  EMAIL_VERIFICATION
  COMMISSION_EARNED
  COMMISSION_PAID
  ORDER_PLACED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUND
  SECURITY_ALERT
  ACCOUNT_SUSPENDED
  RANK_ADVANCEMENT
  TEAM_GROWTH
  MONTHLY_REPORT
  PROMOTIONAL
  SYSTEM_MAINTENANCE
  CUSTOM
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationCategory {
  AUTHENTICATION
  COMMISSIONS
  ORDERS
  PAYMENTS
  SECURITY
  SYSTEM
  MARKETING
  PROMOTIONAL
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignType {
  INSTANT
  SCHEDULED
  RECURRING
  AUTOMATED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}